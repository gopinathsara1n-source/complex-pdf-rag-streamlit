# Required for PDF visual understanding and final answer generation
GEMINI_API_KEY=your_google_gemini_api_key

# Validated project defaults
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=16
TARGET_CHARS=1800
MAX_CHARS=3200
MIN_STANDALONE_CHARS=150
RETRIEVAL_TOP_K=5

# Gemini generation fallback order
GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Visual understanding fallback order
GEMINI_VISUAL_MODEL_1=gemini-3.5-flash-lite
GEMINI_VISUAL_MODEL_2=gemini-3.1-flash-lite
GEMINI_VISUAL_MODEL_3=gemini-3.5-flash
GEMINI_VISUAL_MODEL_4=gemini-3.7-flash
